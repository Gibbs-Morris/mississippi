@using System.Globalization
<div @attributes="AdditionalAttributes"
     class="@CssClass"
     role="progressbar"
     data-state="@State"
     data-reduced-motion="@(IsReducedMotion ? "true" : "false")"
     aria-valuenow="@AccessibleValue"
     aria-valuemin="@Min.ToString(CultureInfo.InvariantCulture)"
     aria-valuemax="@Max.ToString(CultureInfo.InvariantCulture)">
    <svg viewBox="0 0 36 36" class="rf-progress-arc__svg" aria-hidden="true" focusable="false">
        <circle class="rf-progress-arc__track" cx="18" cy="18" r="16"/>
        <circle class="rf-progress-arc__fill" cx="18" cy="18" r="16" pathLength="100"
                stroke-dasharray="100" stroke-dashoffset="@DashOffset"
                opacity="@(IsIndeterminate || (ClampedValue > Min) ? "1" : "0")"/>
    </svg>
</div>