<div class="rf-input-field" data-state="@State" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="rf-input-field__label" for="@EffectiveId">@Label</label>
    }
    <input @attributes="InputAttributes"
           class="rf-input-field__input"
           id="@EffectiveId"
           type="@Type"
           value="@Value"
           placeholder="@Placeholder"
           disabled="@IsDisabled"
           readonly="@IsReadOnly"
           @oninput="HandleInputAsync"
           @onfocus="HandleFocusAsync"
           @onblur="HandleBlurAsync"/>
</div>