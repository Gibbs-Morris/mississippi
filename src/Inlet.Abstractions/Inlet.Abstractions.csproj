<Project Sdk="Microsoft.NET.Sdk">
  <!-- 
        Minimal, dependency-free project containing the shared ProjectionPathAttribute.
        This project is intentionally kept light so it can be referenced from:
        - WASM client projects (Blazor WebAssembly)
        - Server projects (Orleans, ASP.NET)
        - Shared contracts projects
    -->
  <PropertyGroup>
    <Description>Public contracts for assigning shared paths to server read models and their client representations for HTTP queries and SignalR subscriptions.</Description>
  </PropertyGroup>
</Project>