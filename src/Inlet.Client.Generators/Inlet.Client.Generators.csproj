<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Description>Source generators for Inlet.Client to reduce boilerplate.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inlet.Generators.Abstractions\Inlet.Generators.Abstractions.csproj" />
    <ProjectReference Include="..\Inlet.Generators.Core\Inlet.Generators.Core.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <!-- Roslyn release tracking requires .md filenames; keep its input format separate from documentation lint. -->
  <Target Name="PrepareDiagnosticReleases" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)DiagnosticReleases" />
    <Copy SourceFiles="AnalyzerReleases.Shipped.txt;AnalyzerReleases.Unshipped.txt"
          DestinationFiles="$(IntermediateOutputPath)DiagnosticReleases/AnalyzerReleases.Shipped.md;$(IntermediateOutputPath)DiagnosticReleases/AnalyzerReleases.Unshipped.md"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <AdditionalFiles Include="$(IntermediateOutputPath)DiagnosticReleases/AnalyzerReleases.Shipped.md" />
      <AdditionalFiles Include="$(IntermediateOutputPath)DiagnosticReleases/AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
  </Target>
</Project>