{
  "schemaVersion": "1.0",
  "checks": [
    {
      "id": "core-iteration",
      "mode": "iteration",
      "executable": "pwsh",
      "arguments": ["./go.ps1", "-SkipCleanup"],
      "scriptPaths": ["go.ps1"],
      "purpose": "Fast provisional build and unit-test feedback for .NET or unknown changes.",
      "prerequisites": [".NET SDK selected by global.json"],
      "expectedArtifacts": ["pipeline console summary"]
    },
    {
      "id": "core-final",
      "mode": "final",
      "executable": "pwsh",
      "arguments": ["./go.ps1"],
      "scriptPaths": ["go.ps1"],
      "purpose": "Authoritative local build, tests, coverage summary, cleanup, and final build.",
      "prerequisites": [".NET SDK and local tools"],
      "expectedArtifacts": ["coverage summaries", "final build output"]
    },
    {
      "id": "full-cleanup",
      "mode": "final",
      "executable": "pwsh",
      "arguments": ["./clean-up.ps1"],
      "scriptPaths": ["clean-up.ps1"],
      "purpose": "Apply the repository cleanup contract before final handoff.",
      "prerequisites": ["local ReSharper tool restore"],
      "expectedArtifacts": ["clean working tree or reviewed cleanup diff"]
    },
    {
      "id": "powershell-tests",
      "mode": "final",
      "executable": "pwsh",
      "arguments": ["./eng/tests/orchestrate-powershell-tests.ps1"],
      "scriptPaths": ["eng/tests/orchestrate-powershell-tests.ps1"],
      "purpose": "Run the engineering-script Pester and script integration suites.",
      "prerequisites": ["PowerShell 7", "Pester 5"],
      "expectedArtifacts": ["Pester summary"]
    },
    {
      "id": "markdown-lint",
      "mode": "final",
      "executable": "npx",
      "arguments": ["--yes", "markdownlint-cli2", "{{CHANGED_MARKDOWN_PATHS}}"],
      "scriptPaths": [],
      "purpose": "Lint changed Markdown and MDX content.",
      "prerequisites": ["Node.js", "npm registry or cached markdownlint-cli2"],
      "expectedArtifacts": ["markdownlint summary"]
    },
    {
      "id": "spring-doctor",
      "mode": "prerequisite",
      "executable": "pwsh",
      "arguments": ["./test-spring.ps1", "-Doctor"],
      "scriptPaths": ["test-spring.ps1"],
      "purpose": "Check Spring SDK and Docker Linux prerequisites.",
      "prerequisites": ["PowerShell 7", "Linux Docker daemon"],
      "expectedArtifacts": ["READY doctor result"]
    },
    {
      "id": "spring-smoke",
      "mode": "final",
      "executable": "pwsh",
      "arguments": ["./test-spring.ps1"],
      "scriptPaths": ["test-spring.ps1"],
      "purpose": "Run the Spring L3 browser smoke journey when browser behavior is affected.",
      "prerequisites": ["Linux Docker daemon", "Playwright Chromium"],
      "expectedArtifacts": ["PASS summary", "spring.trx", "banking.png"]
    }
  ]
}
