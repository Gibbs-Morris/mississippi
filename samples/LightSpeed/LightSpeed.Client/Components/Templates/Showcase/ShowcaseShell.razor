@using Mississippi.Refraction.Client.Infrastructure.Theming
<CascadingRefractionProvider ThemeMode="@ThemeMode" Class="showcase-theme">
    <a class="skip-link" href="@($"{PagePath}#main-content")" @onclick="FocusContentAsync">Skip to content</a>
    <div class="shell">
        <header class="topbar">
            <a class="wordmark" href="/">LIGHTSPEED <span>by Mississippi</span></a>
            <nav class="navigation" aria-label="Main navigation">
                <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
                <NavLink href="/kitchen-sink">Kitchen sink</NavLink>
            </nav>
            <div class="theme-options" role="group" aria-label="Color theme">
                @foreach (RefractionThemeMode mode in Modes)
                {
                    <button type="button" aria-pressed="@(mode == ThemeMode ? "true" : "false")"
                            @onclick="() => ThemeChanged.InvokeAsync(mode)">
                        @GetModeLabel(mode)
                    </button>
                }
            </div>
        </header>
        <main id="main-content" tabindex="-1" @ref="MainContent">
            <div class="heading">
                <p class="eyebrow">REFRACTION / COMPONENT LAB</p>
                <h1 tabindex="-1">@Title</h1>
                <p class="lead">@Subtitle</p>
            </div>
            @ChildContent
        </main>
        <footer>Atomic composition. State down. Intent up.</footer>
    </div>
</CascadingRefractionProvider>
