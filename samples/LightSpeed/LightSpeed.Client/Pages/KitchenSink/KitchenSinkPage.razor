@page "/kitchen-sink"
@using Mississippi.Refraction.Client.Components.Atoms.Input
@using MississippiSamples.LightSpeed.Client.Components.Molecules.Activation
@using MississippiSamples.LightSpeed.Client.Components.Molecules.Profile
@using MississippiSamples.LightSpeed.Client.Components.Molecules.Progress
@using MississippiSamples.LightSpeed.Client.Components.Organisms.Notifications
@using MississippiSamples.LightSpeed.Client.Components.Templates.Showcase
@inherits StoreComponent
<PageTitle>Kitchen sink — LightSpeed</PageTitle>
<ShowcaseShell Title="Controls, with nothing hidden."
               Subtitle="Edit the form, validate it, and inspect the resulting state. Every interaction follows the same Reservoir path."
               ThemeMode="@View.ThemeMode" ThemeChanged="ChangeTheme" PagePath="/kitchen-sink">
    <div class="demo-grid">
        <section class="panel">
            <ProfileForm View="@View" EmailChanged="ChangeEmail" Validate="ValidateProfile" Reset="ResetProfile"/>
        </section>
        <aside class="inspector" aria-label="Reservoir state inspector">
            <p class="label">RESERVOIR / LIVE STATE</p>
            <h2>Follow the change.</h2>
            <dl>
                <dt>Last action</dt>
                <dd data-testid="last-action">@View.LastAction</dd>
                <dt>Actions dispatched</dt>
                <dd data-testid="action-count">@View.ActionCount</dd>
                <dt>Selected theme</dt>
                <dd>@View.ThemeMode</dd>
                <dt>Email</dt>
                <dd data-testid="state-email">@View.Email</dd>
                <dt>Input state</dt>
                <dd>@View.InputState</dd>
                <dt>Emitter activations</dt>
                <dd data-testid="state-emitter-count">@View.EmitterActivationCount</dd>
                <dt>Emitter disabled</dt>
                <dd data-testid="state-emitter-disabled">@(View.IsEmitterDisabled ? "true" : "false")</dd>
                <dt>Progress</dt>
                <dd data-testid="state-progress">@(View.ProgressPercent is null ? "Unknown" : $"{View.ProgressPercent}%")</dd>
                <dt>Notification visible</dt>
                <dd data-testid="state-notification-visible">@(View.IsNotificationVisible ? "true" : "false")</dd>
                <dt>Notification expanded</dt>
                <dd data-testid="state-notification-expanded">@(View.IsNotificationExpanded ? "true" : "false")</dd>
            </dl>
            <p class="note">Callback → page dispatch → reducer → selector → component.</p>
        </aside>
    </div>
    <section class="states" aria-labelledby="states-title">
        <div>
            <p class="label">ATOM / INPUT FIELD</p>
            <h2 id="states-title">Everyday states</h2>
        </div>
        <div class="state-grid">
            <InputField Label="Read only" Value="Managed by your team" IsReadOnly="true"/>
            <InputField Label="Disabled" Value="Available after setup" IsDisabled="true"/>
        </div>
    </section>
    <div class="states">
        <ProgressDemo Percent="@View.ProgressPercent" PercentChanged="ChangeProgress"/>
    </div>
    <div class="states">
        <EmitterDemo ActivationCount="@View.EmitterActivationCount"
                     IsDisabled="@View.IsEmitterDisabled"
                     Activated="ActivateEmitter"
                     DisabledChanged="ChangeEmitterDisabled"/>
    </div>
    <div class="states">
        <NotificationDemo IsVisible="@View.IsNotificationVisible"
                          IsExpanded="@View.IsNotificationExpanded"
                          ExpandRequested="ExpandNotification"
                          DismissRequested="DismissNotification"
                          RestoreRequested="RestoreNotification"/>
    </div>
    <section class="maturity" aria-labelledby="maturity-title">
        <h2 id="maturity-title">What is ready to explore?</h2>
        <p><strong>Verified here:</strong> input identity, helper/error feedback, focus behavior, theme scopes, progress arcs, native emitter activation, notification restoration, and Reservoir integration.</p>
        <p><strong>Prototypes in the library:</strong> Reticle, CalloutLine, CommandOrbit, TelemetryStrip, Pane, SchematicViewer, and SmokeConfirm. Their broader interaction and accessibility work is still in progress.</p>
    </section>
</ShowcaseShell>