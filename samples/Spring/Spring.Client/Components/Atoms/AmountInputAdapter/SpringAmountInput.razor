@namespace MississippiSamples.Spring.Client.Components.Atoms.AmountInputAdapter

<InputField Id="@InputId"
            Label="@Label"
            Type="text"
            Value="@draft"
            ValueChanged="@HandleInputAsync"
            State="@InputState"
            ErrorText="@errorText"
            HelperText="Use a period (.) for decimal values."
            InputAttributes="@NativeInputAttributes"
            IsDisabled="@IsDisabled"
            Placeholder="@Placeholder"/>