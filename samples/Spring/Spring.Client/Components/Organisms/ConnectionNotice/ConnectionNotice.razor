@namespace MississippiSamples.Spring.Client.Components.Organisms

@if (IsOpen)
{
    <section class="spring-connection-notice" aria-label="Live connection notice">
        <div role="status">
            <strong>@(ConnectionStatusText is "Connecting" or "Reconnecting" ? "Connecting to live updates" : "Live updates are disconnected")</strong>
            <p>
                Status: @ConnectionStatusText. Displayed projections may be out of date.
                Command responses do not confirm that these views have refreshed.
            </p>
            @if (ReconnectAttemptCount > 0)
            {
                <p>Reconnect attempt @ReconnectAttemptCount</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(LastError))
        {
            <p role="alert">@LastError</p>
        }
        <button type="button" @onclick="OnReconnect" disabled="@(ConnectionStatusText is "Connecting" or "Reconnecting")">Reconnect</button>
    </section>
}