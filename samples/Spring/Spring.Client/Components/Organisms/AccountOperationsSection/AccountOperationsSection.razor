@using Mississippi.Refraction.Client.Components.Molecules
@namespace MississippiSamples.Spring.Client.Components.Organisms

<header>
    <h2 id="@PanelHeadingId">@PanelLabel: @SelectedEntityId</h2>
    <button type="button" @onclick="OnSwitchAccount" aria-label="@($"Switch {PanelLabel} account")">Switch</button>
</header>

<Pane Title="Open Account">
    <fieldset disabled="@(IsExecutingOrLoading || IsAccountOpen)">
        <legend>Open Account</legend>
        @if (IsAccountOpen)
        {
            <p>
                <em>Account is already open.</em>
            </p>
        }
        else
        {
            <div>
                <label for="@HolderNameInputId">@PanelLabel holder name</label>
                <InputText id="@HolderNameInputId"
                           type="text"
                           Value="HolderName"
                           ValueChanged="HolderNameChanged"
                           ValueExpression="() => HolderName"
                           placeholder="Account holder name"/>
            </div>
            <div>
                @RenderAmountInput(InitialDepositInputId, $"{PanelLabel} initial deposit (£)", InitialDeposit, InitialDepositChanged, SetInitialDepositValidity, IsExecutingOrLoading)
            </div>
            <button type="button" @onclick="OnOpenAccount" disabled="@(IsExecutingOrLoading || !isInitialDepositValid)">
                Open Account
            </button>
        }
    </fieldset>
</Pane>

<Pane Title="Deposit (£)">
    <fieldset disabled="@(IsExecutingOrLoading || !IsAccountOpen)">
        <legend>Deposit Funds (GBP)</legend>
        <div>
            @RenderAmountInput(DepositAmountInputId, $"{PanelLabel} deposit amount (£)", DepositAmount, DepositAmountChanged, SetDepositAmountValidity, IsExecutingOrLoading || !IsAccountOpen)
        </div>
        <button type="button" @onclick="OnDeposit" disabled="@(IsExecutingOrLoading || !IsAccountOpen || !isDepositAmountValid)">
            Deposit £
        </button>
        <div>
            <span>Quick:</span>
            <button type="button" @onclick="OnDepositSingle100" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">+£100</button>
            <button type="button" @onclick="OnDepositBurst20" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">20×£5</button>
            <button type="button" @onclick="OnDepositBurst200" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">200×£10</button>
        </div>
    </fieldset>
</Pane>

<Pane Title="Withdraw">
    <fieldset disabled="@(IsExecutingOrLoading || !IsAccountOpen)">
        <legend>Withdraw Funds</legend>
        <div>
            @RenderAmountInput(WithdrawAmountInputId, $"{PanelLabel} withdrawal amount (£)", WithdrawAmount, WithdrawAmountChanged, SetWithdrawAmountValidity, IsExecutingOrLoading || !IsAccountOpen)
        </div>
        <button type="button" @onclick="OnWithdraw" disabled="@(IsExecutingOrLoading || !IsAccountOpen || !isWithdrawAmountValid)">Withdraw</button>
        <div>
            <span>Quick:</span>
            <button type="button" @onclick="OnWithdrawSingle100" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">-£100</button>
            <button type="button" @onclick="OnWithdrawBurst20" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">20×£5</button>
            <button type="button" @onclick="OnWithdrawBurst200" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">200×£10</button>
        </div>
    </fieldset>
</Pane>

<Pane Title="Transfer" id="@TransferPanelId">
    <div class="spring-transfer__content">
        <fieldset class="spring-transfer__form" disabled="@(IsExecutingOrLoading || !IsAccountOpen)">
            <legend>Transfer Between Accounts</legend>
            <div class="spring-transfer__field">
                <label for="@TransferDestinationInputId">@PanelLabel transfer destination account</label>
                <InputText id="@TransferDestinationInputId"
                           type="text"
                           disabled="@IsTransferDestinationReadOnly"
                           readonly="@IsTransferDestinationReadOnly"
                           Value="@TransferDestinationAccountId"
                           ValueChanged="TransferDestinationAccountIdChanged"
                           ValueExpression="() => TransferDestinationAccountId"
                           placeholder="Destination account ID"/>
            </div>
            <div class="spring-transfer__field">
                <label for="@TransferAmountInputId">@PanelLabel transfer amount (£)</label>
                <InputNumber id="@TransferAmountInputId"
                             Value="TransferAmount"
                             ValueChanged="TransferAmountChanged"
                             ValueExpression="() => TransferAmount"
                             placeholder="0.00"
                             step="0.01"
                             min="0"/>
            </div>
            <button type="button"
                    @onclick="OnStartTransfer"
                    disabled="@(IsExecutingOrLoading || !IsAccountOpen)">
                Start Transfer
            </button>
        </fieldset>

        <TelemetryStrip State="@TransferStatusState"
                        id="@TransferStatusId"
                        data-spring-transfer-status="true"
                        aria-label="@($"{PanelLabel} transfer status")">
            <div class="spring-transfer__status-details">
                @if (!string.IsNullOrWhiteSpace(TransferSagaId))
                {
                    <span>
                        <strong>Transfer saga ID:</strong> @TransferSagaId
                    </span>
                }

                @if (TransferStatusProjection is null)
                {
                    <span>@(string.IsNullOrWhiteSpace(TransferSagaId) ? "Start a transfer to see saga status." : "Waiting for transfer status.")</span>
                }
                else
                {
                    <span>
                        <strong>Phase:</strong> @TransferStatusProjection.Phase
                    </span>
                    <span>
                        <strong>Last completed step:</strong> @LastCompletedStepText
                    </span>
                    @if (TransferStatusProjection.StartedAt is not null)
                    {
                        <span>
                            <strong>Started:</strong> @FormatTransferTimestamp(TransferStatusProjection.StartedAt)
                        </span>
                    }

                    @if (TransferStatusProjection.CompletedAt is not null)
                    {
                        <span>
                            <strong>Finished:</strong> @FormatTransferTimestamp(TransferStatusProjection.CompletedAt)
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(TransferStatusProjection.ErrorCode))
                    {
                        <span>
                            <strong>Error code:</strong> @TransferStatusProjection.ErrorCode
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(TransferStatusProjection.ErrorMessage))
                    {
                        <span>
                            <strong>Error:</strong> @TransferStatusProjection.ErrorMessage
                        </span>
                    }
                }
            </div>
        </TelemetryStrip>
    </div>
</Pane>

<section>
    <h2>Account Status</h2>
    @if (BalanceProjection is not null)
    {
        <div>
            <div>
                <span>Balance:</span>
                <span>@BalanceProjection.Balance.ToString("C")</span>
            </div>
            <div>
                <span>Holder:</span>
                <span>@BalanceProjection.HolderName</span>
            </div>
            <div>
                <span>Status:</span>
                <span>@(BalanceProjection.IsOpen ? "Open" : "Closed")</span>
            </div>
        </div>
    }
    else
    {
        <div>
            <h3>Awaiting Data</h3>
            <p>Open an account to begin viewing real-time projection data.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div role="alert">
            <strong>Error:</strong> @ErrorMessage
        </div>
    }

    @if (LastCommandSucceeded is true)
    {
        <div role="status">
            Command executed successfully.
        </div>
    }
</section>

<section>
    <h2>Transaction Ledger</h2>
    @if (LedgerProjection?.Entries.Length > 0)
    {
        <table>
            <thead>
            <tr>
                <th>Type</th>
                <th>Amount (£)</th>
            </tr>
            </thead>
            <tbody>
            @foreach (LedgerEntryDto entry in LedgerProjection.Entries)
            {
                <tr>
                    <td>@entry.EntryType</td>
                    <td>@entry.Amount</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p>No transactions yet.</p>
    }
</section>