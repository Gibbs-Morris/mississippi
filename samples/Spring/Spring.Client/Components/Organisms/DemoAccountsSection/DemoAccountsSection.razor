@namespace MississippiSamples.Spring.Client.Components.Organisms

<Pane Title="Demo Accounts" aria-label="Demo account setup">
    <p>Initialize two demo accounts to quickly exercise transfers and projections.</p>
    <button type="button" @onclick="OnInitialize" disabled="@IsExecutingOrLoading">
        Initialize demo accounts
    </button>
    @if (IsInitialized)
    {
        <dl>
            <div>
                <dt>Account A</dt>
                <dd>@(AccountAName ?? "Account A")</dd>
                <dd id="demo-account-a-id" aria-label="Account A ID">@AccountAId</dd>
            </div>
            <div>
                <dt>Account B</dt>
                <dd>@(AccountBName ?? "Account B")</dd>
                <dd id="demo-account-b-id" aria-label="Account B ID">@AccountBId</dd>
            </div>
        </dl>
    }
</Pane>