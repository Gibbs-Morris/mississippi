@page "/operations"
@namespace MississippiSamples.Spring.Client.Pages
@using Mississippi.Inlet.Client.SignalRConnection
@inherits InletComponent

<PageTitle>Move money · Spring</PageTitle>
<main class="spring-operations">
    <BankAccountPageHeader Title="Move money"
                           Subtitle="Start with a £25 deposit. Verify the increase in the live balance and the new ledger entry."
                           TipText=""
                           ConnectionStatusText="@ConnectionStatus.ToString()"
                           IsConnectionDetailsOpen="@isConnectionDetailsOpen"
                           OnNavigateInvestigations="@NavigateToInvestigations"
                           OnToggleConnectionDetails="@ToggleConnectionDetails"/>
    <ConnectionDetails IsOpen="@isConnectionDetailsOpen"
                       ConnectionStatusText="@ConnectionStatus.ToString()"
                       ConnectionIdText="@ConnectionIdDisplay"
                       ReconnectAttemptCount="@ReconnectAttemptCount"
                       LastConnectedAtText="@LastConnectedAtDisplay"
                       LastDisconnectedAtText="@LastDisconnectedAtDisplay"
                       LastMessageReceivedAtText="@LastMessageReceivedAtDisplay"
                       LastError="@LastError"
                       OnClose="@CloseConnectionDetails"/>
    <ConnectionNotice IsOpen="@IsDisconnected"
                      ConnectionStatusText="@ConnectionStatus.ToString()"
                      ReconnectAttemptCount="@ReconnectAttemptCount"
                      LastError="@LastError"
                      OnReconnect="@RequestReconnect"/>

    @if (!HasAccountPair)
    {
        <section class="spring-empty">
            <h2>First, choose two accounts</h2>
            <p>Prepare Ada and Grace with £500 each, or choose your own account IDs. Then return here to make a change and verify its outcome.</p>
            <a class="spring-button spring-primary" href="/accounts">Prepare accounts</a>
        </section>
    }
    else
    {
        <nav class="spring-account-jumps" aria-label="Account panels">
            <a href="@($"{ShareUrl}#account-a-operations-panel")"
               @onclick="@(args => FocusAccountPanelAsync(accountAPanelElement, args))">
                Account A ↓
            </a>
            <a href="@($"{ShareUrl}#account-b-operations-panel")"
               @onclick="@(args => FocusAccountPanelAsync(accountBPanelElement, args))">
                Account B ↓
            </a>
        </nav>
        <CommandActivity State="@CommandState" Label="Banking responses · this browser"
                         Explanation="Shared history for this browser, including earlier account selections. Verify the live balances and ledgers below."/>
        @if (TransferCommandState.CommandHistory.Count > 0)
        {
            <CommandActivity State="@TransferCommandState" Label="Transfer-start responses · this browser"
                             Explanation="This shared history includes earlier account selections. An accepted start request does not mean the transfer completed. Follow the saga phase in the account panel and verify both balances."/>
        }

        <div class="operations-panels">
            <div @ref="accountAPanelElement" id="account-a-operations-panel" class="operations-panel" tabindex="-1" role="region" aria-labelledby="account-a-panel-heading">
                <AccountOperationsSection PanelLabel="Account A"
                                          InputIdPrefix="account-a"
                                          SelectedEntityId="@AccountAIdDisplay"
                                          IsExecutingOrLoading="@IsExecutingOrLoadingFor(AccountAId)"
                                          IsAccountOpen="@IsAccountOpenFor(AccountAId)"
                                          HolderName="@panelA.HolderName"
                                          HolderNameChanged="@(value => panelA.HolderName = value)"
                                          InitialDeposit="@panelA.InitialDeposit"
                                          InitialDepositChanged="@(value => panelA.InitialDeposit = value)"
                                          OnOpenAccount="@OpenAccountA"
                                          DepositAmount="@panelA.DepositAmount"
                                          DepositAmountChanged="@(value => panelA.DepositAmount = value)"
                                          OnDeposit="@DepositA"
                                          OnDepositSingle100="@DepositSingle100A"
                                          OnDepositBurst20="@DepositBurst20A"
                                          OnDepositBurst200="@DepositBurst200A"
                                          WithdrawAmount="@panelA.WithdrawAmount"
                                          WithdrawAmountChanged="@(value => panelA.WithdrawAmount = value)"
                                          OnWithdraw="@WithdrawA"
                                          OnWithdrawSingle100="@WithdrawSingle100A"
                                          OnWithdrawBurst20="@WithdrawBurst20A"
                                          OnWithdrawBurst200="@WithdrawBurst200A"
                                          TransferDestinationAccountId="@panelA.TransferDestinationAccountId"
                                          TransferDestinationAccountIdChanged="@(value => panelA.TransferDestinationAccountId = value)"
                                          IsTransferDestinationReadOnly="true"
                                          TransferAmount="@panelA.TransferAmount"
                                          TransferAmountChanged="@(value => panelA.TransferAmount = value)"
                                          OnStartTransfer="@StartTransferA"
                                          TransferSagaId="@panelA.TransferSagaId"
                                          TransferStatusProjection="@TransferStatusProjectionA"
                                          BalanceProjection="@BalanceProjectionA"
                                          ErrorMessage="@(GetReadError<BankAccountBalanceProjectionDto>(AccountAId))"
                                          BalanceVersion="@(GetReadVersion<BankAccountBalanceProjectionDto>(AccountAId))"
                                          IsBalanceLoading="@(IsReadLoading<BankAccountBalanceProjectionDto>(AccountAId))"
                                          IsLedgerLoading="@(IsReadLoading<BankAccountLedgerProjectionDto>(AccountAId))"
                                          IsLiveConnectionConnected="@(ConnectionStatus == SignalRConnectionStatus.Connected)"
                                          LedgerError="@(GetReadError<BankAccountLedgerProjectionDto>(AccountAId))"
                                          LedgerVersion="@(GetReadVersion<BankAccountLedgerProjectionDto>(AccountAId))"
                                          TransferReadError="@(GetReadError<MoneyTransferStatusProjectionDto>(panelA.TransferSagaId))"
                                          LedgerProjection="@LedgerProjectionA"
                                          OnSwitchAccount="@ClearAccountA"/>
            </div>
            <div @ref="accountBPanelElement" id="account-b-operations-panel" class="operations-panel" tabindex="-1" role="region" aria-labelledby="account-b-panel-heading">
                <AccountOperationsSection PanelLabel="Account B"
                                          InputIdPrefix="account-b"
                                          SelectedEntityId="@AccountBIdDisplay"
                                          IsExecutingOrLoading="@IsExecutingOrLoadingFor(AccountBId)"
                                          IsAccountOpen="@IsAccountOpenFor(AccountBId)"
                                          HolderName="@panelB.HolderName"
                                          HolderNameChanged="@(value => panelB.HolderName = value)"
                                          InitialDeposit="@panelB.InitialDeposit"
                                          InitialDepositChanged="@(value => panelB.InitialDeposit = value)"
                                          OnOpenAccount="@OpenAccountB"
                                          DepositAmount="@panelB.DepositAmount"
                                          DepositAmountChanged="@(value => panelB.DepositAmount = value)"
                                          OnDeposit="@DepositB"
                                          OnDepositSingle100="@DepositSingle100B"
                                          OnDepositBurst20="@DepositBurst20B"
                                          OnDepositBurst200="@DepositBurst200B"
                                          WithdrawAmount="@panelB.WithdrawAmount"
                                          WithdrawAmountChanged="@(value => panelB.WithdrawAmount = value)"
                                          OnWithdraw="@WithdrawB"
                                          OnWithdrawSingle100="@WithdrawSingle100B"
                                          OnWithdrawBurst20="@WithdrawBurst20B"
                                          OnWithdrawBurst200="@WithdrawBurst200B"
                                          TransferDestinationAccountId="@panelB.TransferDestinationAccountId"
                                          TransferDestinationAccountIdChanged="@(value => panelB.TransferDestinationAccountId = value)"
                                          IsTransferDestinationReadOnly="true"
                                          TransferAmount="@panelB.TransferAmount"
                                          TransferAmountChanged="@(value => panelB.TransferAmount = value)"
                                          OnStartTransfer="@StartTransferB"
                                          TransferSagaId="@panelB.TransferSagaId"
                                          TransferStatusProjection="@TransferStatusProjectionB"
                                          BalanceProjection="@BalanceProjectionB"
                                          ErrorMessage="@(GetReadError<BankAccountBalanceProjectionDto>(AccountBId))"
                                          BalanceVersion="@(GetReadVersion<BankAccountBalanceProjectionDto>(AccountBId))"
                                          IsBalanceLoading="@(IsReadLoading<BankAccountBalanceProjectionDto>(AccountBId))"
                                          IsLedgerLoading="@(IsReadLoading<BankAccountLedgerProjectionDto>(AccountBId))"
                                          IsLiveConnectionConnected="@(ConnectionStatus == SignalRConnectionStatus.Connected)"
                                          LedgerError="@(GetReadError<BankAccountLedgerProjectionDto>(AccountBId))"
                                          LedgerVersion="@(GetReadVersion<BankAccountLedgerProjectionDto>(AccountBId))"
                                          TransferReadError="@(GetReadError<MoneyTransferStatusProjectionDto>(panelB.TransferSagaId))"
                                          LedgerProjection="@LedgerProjectionB"
                                          OnSwitchAccount="@ClearAccountB"/>
            </div>
        </div>
        <details class="spring-share-pair">
            <summary>Open this pair in another browser</summary>
            <p>
                Use the same running Spring server. This link selects accounts; it does not grant access.
                Compare both windows while making a deposit to see live projection updates.
            </p>
            <a href="@ShareUrl">@ShareUrl</a>
        </details>
    }


</main>