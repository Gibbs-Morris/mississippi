@page "/auth-proof"
@namespace MississippiSamples.Spring.Client.Pages
@using MississippiSamples.Spring.Client.Components.Molecules
@inherits InletComponent

<PageTitle>Test access · Spring</PageTitle>
<main class="spring-auth">
    <header class="spring-auth-header">
        <p class="spring-kicker">SPRING / AUTHORIZATION</p>
        <h1>Test who can do what</h1>
        <p>Change a local persona, send a protected command and compare the actual response with the expected access.</p>
    </header>
    <Pane Title="Before you begin">
        <div class="spring-auth-prerequisite">
            <p>
                Launch Spring with <code>pwsh ./run-spring.ps1 -LocalAuth On</code>.
                This enables the sample's header-based local authentication simulation.
                It is a development demonstration, not production identity.
            </p>
            <p>
                With <strong>LocalAuth Off</strong>, protected Auth Proof endpoints return 401 regardless of persona.
                This page does not detect the server's launch mode.
            </p>
            <p>Personas also affect banking requests. Restore <strong>Full Access</strong> before returning to the money journeys.</p>
        </div>
    </Pane>
    <Pane Title="1 · Choose a persona" aria-label="Local auth persona">
        <div class="spring-persona-content">
            <div class="spring-personas" role="group" aria-label="Local auth persona selection">
                <button type="button" aria-pressed="@(ActivePersonaName == "Unauthenticated" ? "true" : "false")" @onclick="UseUnauthenticatedPersona">Unauthenticated</button>
                <button type="button" aria-pressed="@(ActivePersonaName == "Operator Roles" ? "true" : "false")" @onclick="UseOperatorOnlyPersona">Operator Roles</button>
                <button type="button" aria-pressed="@(ActivePersonaName == "AuthProof Role" ? "true" : "false")" @onclick="UseAuthProofRolePersona">AuthProof Role</button>
                <button type="button" aria-pressed="@(ActivePersonaName == "AuthProof Claim" ? "true" : "false")" @onclick="UseAuthProofClaimPersona">AuthProof Claim</button>
                <button type="button" aria-pressed="@(ActivePersonaName == "Full Access" ? "true" : "false")" @onclick="UseFullAccessPersona">Full Access</button>
            </div>
            <div class="spring-persona-expectation" role="status">
                <strong>Active persona: @ActivePersonaName</strong>
                <p>@ActivePersonaDescription</p>
                <p>200 means allowed; 401 means no authenticated identity; 403 means the identity lacks the required access.</p>
            </div>
            <InputField Id="auth-proof-entity" Label="Auth Proof entity ID" Value="@entityIdInput"
                        ValueChanged="@(value => entityIdInput = value)" HelperText="Use a new ID to isolate your experiment. Blank uses auth-proof."/>
            <p>Current entity: <code>@ProjectionEntityIdDisplay</code>. Responses and history retain earlier personas and entities. Send a new command to test this selection.</p>
        </div>
    </Pane>
    <Pane Title="2 · Send a protected command">
        <div class="spring-proof-grid">
            <div>
                <h2>Authenticated access</h2>
                <p>Requires an authenticated identity.</p>
                <button type="button" @onclick="RecordAuthenticatedAccess" disabled="@AggregateStateSnapshot.IsExecuting">Record Authenticated Access</button>
            </div>
            <div>
                <h2>Claim policy</h2>
                <p>Requires <code>spring.permission=auth-proof</code>.</p>
                <button type="button" @onclick="RecordPolicyAccess" disabled="@AggregateStateSnapshot.IsExecuting">Record Policy Access</button>
            </div>
            <div>
                <h2>Role rule</h2>
                <p>Requires the <code>auth-proof-operator</code> role.</p>
                <button type="button" @onclick="RecordRoleAccess" disabled="@AggregateStateSnapshot.IsExecuting">Record Role Access</button>
            </div>
        </div>
    </Pane>
    <CommandActivity State="@AggregateStateSnapshot" Label="Auth Proof command responses"
                     Explanation="Compare these actual responses with the active persona's expected access. Acceptance is separate from a projection read."/>
    <Pane Title="3 · Verify the read projection">
        <div class="spring-auth-outcome">
            <p>
                This projection counts authenticated-access events only. Role and policy commands do not increment it.
                Reading the projection itself requires the claim policy.
            </p>
            <button type="button" @onclick="RefreshProtectedRead" disabled="@IsAuthProjectionLoading">Refresh protected read</button>
            <p>Refresh after an accepted command to verify the event count. A live subscription can be denied separately from a protected HTTP read.</p>
            @if (!string.IsNullOrEmpty(ProjectionReadError))
            {
                <p class="spring-auth-error" role="alert">
                    <strong>Projection access failed:</strong> @ProjectionReadError
                </p>
                <p>A denied read does not prove that a command failed. Compare the separate command response above.</p>
            }
            else if (IsAuthProjectionLoading || !IsPersonaReadCurrent)
            {
                <p role="status">Refreshing the projection for this persona…</p>
            }
            else if (ProjectionSnapshot is null)
            {
                <p>No projection data received yet. With Full Access, send Record Authenticated Access and wait for its event.</p>
            }
            else
            {
                <output aria-label="Authenticated access events observed" aria-live="polite" aria-atomic="true">@ProjectionSnapshot.AuthenticatedAccessCount</output>
                <p>Authenticated access events observed · projection version @ProjectionVersion</p>
            }
        </div>
    </Pane>
    <Pane Title="Try a role-protected saga start">
        <div class="spring-auth-saga">
            <p>
                The Auth Proof saga requires <code>auth-proof-operator</code> and runs one no-op step.
                Use a banking transfer to explore a saga that coordinates real account changes.
            </p>
            <button type="button" @onclick="StartAuthProofSaga" disabled="@SagaStateSnapshot.IsExecuting">Start AuthProof Saga</button>
            <p>Last saga id: <code>@LastSagaIdDisplay</code></p>
            <p>Last correlation id: <code>@LastCorrelationIdDisplay</code></p>
        </div>
    </Pane>
    <CommandActivity State="@SagaStateSnapshot" Label="Auth Proof saga-start responses"
                     Explanation="These responses report whether the start request was accepted. They do not display the saga's final workflow phase."/>
    <details class="spring-auth-snapshots">
        <summary>Inspect raw projection and client state snapshots</summary>
        <p>
            These are Reservoir snapshots. Cached projection data can remain after a failed read;
            use the live-read status above to assess the current persona.
        </p>
        <SnapshotTable Title="Projection Snapshot" Rows="@ProjectionSnapshotRows"/>
        <SnapshotTable Title="Aggregate State Snapshot" Rows="@AggregateStateRows"/>
        <SnapshotTable Title="Saga State Snapshot" Rows="@SagaStateRows"/>
    </details>
    <section class="spring-auth-context">
        <h2>What Mississippi enables here</h2>
        <p>
            Authorization attributes on domain commands, the saga and projection become generated gateway checks.
            Generated client actions expose the real accepted or rejected responses through Reservoir.
        </p>
        <a href="/operations">Return to Move money ↗</a>
    </section>
</main>